             ODOO ERP SOLUTIONS
        ========================== -->

        <record id="taskflow_service_erp" model="taskflow.service">

            <field name="sequence">10</field>

            <field name="name">Odoo ERP Solutions</field>

            <field name="short_description">
                Complete ERP implementation and customization.
            </field>

            <field name="overview"><![CDATA[
                <h3>Odoo ERP Implementation</h3>

                <p>
                    We help businesses transform their operations through
                    powerful Odoo ERP solutions that centralize processes,
                    automate workflows, and improve productivity.
                </p>

                <p>
                    Our team configures and customizes Odoo based on your
                    business requirements, creating a scalable ERP system
                    that supports future growth.
                </p>
            ]]></field>


            <field name="service_offer"><![CDATA[
                <ul>
                    <li>Complete Odoo ERP implementation</li>
                    <li>Custom module development</li>
                    <li>Business workflow automation</li>
                    <li>ERP customization</li>
                    <li>Third-party system integration</li>
                    <li>User training and deployment</li>
                </ul>
            ]]></field>


            <field name="benefits"><![CDATA[
                <ul>
                    <li>Centralized business operations</li>
                    <li>Improved efficiency and productivity</li>
                    <li>Real-time reporting and analytics</li>
                    <li>Reduced manual processes</li>
                    <li>Better business decisions</li>
                </ul>
            ]]></field>


            <field name="icon">fa-cubes</field>

            <field name="button_text">Request Demo</field>

            <field name="button_link">/contact</field>

            <field name="active">True</field>

        </record>



