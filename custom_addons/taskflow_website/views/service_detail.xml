<?xml version="1.0" encoding="UTF-8"?>

<odoo>


    <template 
        id="service_detail_page" 
        name="Service Detail Page"
    >


        <t t-call="website.layout">


            <div class="container service-detail-page">


                <!-- BACK BUTTON -->

                <div class="service-back">

                    <a href="/services" class="back-btn">
                        ← Back to Services
                    </a>

                </div>



                <!-- SERVICE HEADER -->

                <section class="service-header">


                    <div class="service-icon">

                        <i t-att-class="'fa ' + service.icon"></i>

                    </div>



                    <h1>

                        <t t-esc="service.name"/>

                    </h1>



                    <p class="service-short">

                        <t t-esc="service.short_description"/>

                    </p>



                    <a 
                        t-att-href="'/contact?service=%s' % service.id"
                        class="service-main-btn"
                    >

                        <t t-esc="service.button_text"/>

                    </a>



                </section>





                <!-- OVERVIEW -->

                <section class="detail-section">


                    <h2>
                        Overview
                    </h2>



                    <div class="content-box">

                        <div t-field="service.overview"/>

                    </div>


                </section>







                <!-- SERVICES OFFERED -->


                <section class="detail-section">


                    <h2>
                        What We Offer
                    </h2>



                    <div class="content-box">

                        <div t-field="service.service_offer"/>

                    </div>


                </section>







                <!-- BENEFITS -->


                <section class="detail-section">


                    <h2>
                        Business Benefits
                    </h2>



                    <div class="content-box">

                        <div t-field="service.benefits"/>

                    </div>


                </section>







                <!-- CTA SECTION -->


                <section class="service-cta">


                    <h2>
                        Ready To Transform Your Business?
                    </h2>



                    <p>
                        Contact TaskFlow Solutions today.
                    </p>



                    <a 
                        t-att-href="'/contact?service=%s' % service.id"
                        class="service-main-btn"
                    >

                        Contact Experts

                    </a>



                </section>



            </div>


        </t>


    </template>


</odoo>