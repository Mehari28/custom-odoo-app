<?xml version="1.0" encoding="UTF-8"?>

<odoo>


    <template
        id="service_detail_page"
        name="TaskFlow Service Detail"
    >


        <t t-call="website.layout">


            <section class="service-detail-page">


                <div class="container">



                    <!-- BACK BUTTON -->

                    <a href="/services"
                       class="back-services">

                        ← Back to Services

                    </a>






                    <!-- SERVICE HEADER -->

                    <div class="service-detail-header">



                        <!-- ICON -->

                        <div class="service-detail-icon">


                            <i t-att-class="'fa ' + service.icon"/>


                        </div>





                        <!-- TITLE -->

                        <h1>

                            <t t-esc="service.name"/>

                        </h1>






                        <!-- SHORT DESCRIPTION -->

                        <p class="service-subtitle">


                            <t t-esc="service.short_description"/>


                        </p>



                    </div>









                    <!-- SERVICE DETAILS -->

                    <div class="service-detail-card">



                        <t t-if="service.detailed_description">


                            <t t-raw="service.detailed_description"/>



                        </t>



                        <t t-else="">


                            <h2>

                                About This Service

                            </h2>



                            <p>

                                Detailed information about this service
                                will be available soon.

                            </p>


                        </t>



                    </div>









                    <!-- CONTACT CTA -->

                    <div class="service-contact-box">



                        <h2>

                            Ready to transform your business?

                        </h2>





                        <p>

                            Contact TaskFlow Solutions today and
                            let's discuss how we can help your business
                            grow with technology.

                        </p>






                        <a
                            t-att-href="'/contact?service=' + str(service.id)"
                            class="contact-button"
                        >

                            Contact Us →

                        </a>




                    </div>





                </div>



            </section>



        </t>



    </template>



</odoo>