<?xml version="1.0" encoding="UTF-8"?>

<odoo>


    <template
        id="contact_page"
        name="Contact TaskFlow"
    >


        <t t-call="website.layout">


            <section class="contact-hero">


                <div class="container">


                    <h1>
                        Let's Build Something Great Together
                    </h1>


                    <p>
                        Contact TaskFlow Solutions for ERP,
                        automation and digital transformation solutions.
                    </p>


                </div>


            </section>





            <section class="contact-section">


                <div class="container">


                    <div class="contact-grid">





                        <!-- CONTACT INFORMATION -->


                        <div class="contact-card">


                            <h2>
                                Get In Touch
                            </h2>


                            <p>
                                Our team is ready to help your
                                business improve operations through
                                smart technology.
                            </p>





                            <div class="contact-item">


                                <strong>
                                    Email
                                </strong>


                                <p>
                                    info@taskflowsolutions.com
                                </p>


                            </div>






                            <div class="contact-item">


                                <strong>
                                    Phone
                                </strong>


                                <p>
                                    +250 XXX XXX XXX
                                </p>


                            </div>






                            <div class="contact-item">


                                <strong>
                                    Location
                                </strong>


                                <p>
                                    Kigali, Rwanda
                                </p>


                            </div>



                        </div>










                        <!-- CONTACT FORM -->


                        <div class="contact-card">


                            <h2>
                                Request A Demo
                            </h2>





                            <form action="/contact/submit"
                                  method="post"
                                  class="contact-form">





                                <!-- CSRF TOKEN -->


                                <input type="hidden"
                                       name="csrf_token"
                                       t-att-value="request.csrf_token()"/>







                                <!-- SERVICE ID -->

                                <t t-if="service">


                                    <input type="hidden"
                                           name="service_id"
                                           t-att-value="service.id"/>


                                </t>









                                <div class="form-group">


                                    <label>
                                        Full Name
                                    </label>


                                    <input type="text"
                                           name="name"
                                           required="required"
                                           placeholder="Your name"/>


                                </div>









                                <div class="form-group">


                                    <label>
                                        Email
                                    </label>


                                    <input type="email"
                                           name="email"
                                           required="required"
                                           placeholder="Email address"/>


                                </div>









                                <div class="form-group">


                                    <label>
                                        Company
                                    </label>


                                    <input type="text"
                                           name="company"
                                           placeholder="Company name"/>


                                </div>









                                <div class="form-group">


                                    <label>
                                        Message
                                    </label>


                                    <textarea name="message"
                                              rows="5"
                                              placeholder="Tell us about your project">
                                    </textarea>


                                </div>









                                <button type="submit"
                                        class="contact-submit">


                                    Send Message


                                </button>





                            </form>





                        </div>







                    </div>



                </div>



            </section>





        </t>


    </template>


</odoo>