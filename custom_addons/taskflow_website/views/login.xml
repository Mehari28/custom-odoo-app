<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="taskflow_login_branding"
              inherit_id="web.login_layout">

        <xpath expr="//img[contains(@t-attf-src, '/web/binary/company_logo')]"
               position="replace">

            <div class="text-center pb-3 border-bottom mb-4">

                <img src="/taskflow_website/static/src/images/taskflow_logo.png"
                     alt="TaskFlow Logo"
                     style="max-height:120px; max-width:100%; width:auto;"/>

                <h3 class="mt-3">
                    TaskFlow
                </h3>

                <p class="text-muted">
                    Business Automation &amp; ERP Solutions
                </p>

            </div>

        </xpath>

    </template>

</odoo>