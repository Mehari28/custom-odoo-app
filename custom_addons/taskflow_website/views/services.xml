<?xml version="1.0" encoding="UTF-8"?>

<odoo>

<template 
    id="services_page"
    name="Services Page"
>

<t t-call="website.layout">


<section class="tf-service-hero">

<div class="container">

<h1>
Smart ERP Solutions For Growing Businesses
</h1>

<p>
We design, customize and implement Odoo solutions
that help companies automate operations and improve productivity.
</p>


<a href="/contact"
class="tf-primary-btn">

Request Free Consultation

</a>

</div>

</section>




<section class="container tf-services-section">


<div class="text-center mb-5">

<h2>
Our Services
</h2>


<p>
Solutions designed around your business needs
</p>


</div>



<div class="row">


<t t-foreach="services" t-as="service">


<div class="col-lg-4 col-md-6 mb-4">


<div class="tf-service-box">


<div class="tf-icon">

<i t-att-class="'fa '+service.icon"/>

</div>



<h3>
<t t-esc="service.name"/>
</h3>



<p>
<t t-esc="service.short_description"/>
</p>



<a 
t-att-href="'/services/%s'%service.id"
class="tf-link">

View Solution →

</a>


</div>


</div>


</t>


</div>


</section>





<section class="tf-process">

<div class="container">


<h2 class="text-center">

Our Implementation Process

</h2>



<div class="row text-center mt-5">


<div class="col-md-3">

<h4>01</h4>

<h5>Discovery</h5>

<p>
Understanding your business requirements.
</p>

</div>



<div class="col-md-3">

<h4>02</h4>

<h5>Planning</h5>

<p>
Designing the right solution.
</p>

</div>




<div class="col-md-3">

<h4>03</h4>

<h5>Implementation</h5>

<p>
Configuring and customizing Odoo.
</p>

</div>




<div class="col-md-3">

<h4>04</h4>

<h5>Support</h5>

<p>
Continuous improvement and assistance.
</p>

</div>



</div>


</div>


</section>


</t>

</template>


</odoo>