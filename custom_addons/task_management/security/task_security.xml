<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="task_management_portal_rule" model="ir.rule">
        <field name="name">Portal users: own task requests</field>
        <field name="model_id" ref="model_task_management"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('requester_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
