<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Full event form: button next to "+ Odoo meeting" -->
    <record id="view_calendar_event_form_inherit_teams" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.teams</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='videocall_location_div']//button[@name='set_discuss_videocall_location']" position="after">
                <button name="set_teams_videocall_location" type="object"
                        class="btn btn-link btn-sm px-0 ms-2 text-nowrap"
                        invisible="videocall_location or not user_can_edit">
                    <span class="fa fa-plus"/><span> Teams meeting</span>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Quick-create popup: button next to "+ Video" -->
    <record id="view_calendar_event_form_quick_create_inherit_teams" model="ir.ui.view">
        <field name="name">calendar.event.form.quick_create.inherit.teams</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form_quick_create"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='set_discuss_videocall_location']" position="after">
                <button name="set_teams_videocall_location" type="object"
                        class="mx-1 btn-link text-nowrap" invisible="videocall_location">
                    <span class="fa fa-plus me-1"/>Teams
                </button>
            </xpath>
        </field>
    </record>
</odoo>
