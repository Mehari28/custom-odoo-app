<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="globx_about_page" name="GlobX About">
        <t t-call="website.layout">
            <div id="wrap" class="globx_page">

                <!-- ============ HEADER ============ -->
                <header class="globx_header">
                    <div class="container d-flex align-items-center justify-content-between flex-wrap py-3 gap-3">
                        <a href="/home-globx" class="globx-logo">Globx</a>

                        <nav class="globx-nav d-none d-lg-flex align-items-center gap-4">
                            <a href="/home-globx">Home</a>
                            <a href="/solutions">Solutions</a>
                            <a href="/casestudies">Case Studies</a>
                            <a href="/news">News</a>
                            <a href="/about" class="globx-nav-active">About</a>
                            <a href="/contactus">Contact</a>
                        </nav>

                        <a href="/contactus" class="btn globx-btn-primary globx-header-cta d-none d-lg-inline-block">
                            Book a discovery call
                        </a>

                        <button class="globx-nav-toggle d-lg-none" type="button" aria-label="Toggle navigation" aria-expanded="false">
                            <span/>
                            <span/>
                            <span/>
                        </button>
                    </div>

                    <div class="globx-mobile-nav d-lg-none">
                        <a href="/home-globx">Home</a>
                        <a href="/solutions">Solutions</a>
                        <a href="/casestudies">Case Studies</a>
                        <a href="/news">News</a>
                        <a href="/about" class="globx-nav-active">About</a>
                        <a href="/contactus">Contact</a>
                        <a href="/contactus" class="btn globx-btn-primary mt-2">Book a discovery call</a>
                    </div>
                </header>

                <!-- ============ ABOUT HERO ============ -->
                <section class="globx_about_hero py-5">
                    <div class="container">
                        <div class="row align-items-center gy-4">
                            <div class="col-lg-6">
                                <h1 class="text-white">About GlobX</h1>
                                <p class="globx-about-sub">
                                    GlobX is an Odoo-partnered ERP solutions provider with
                                    operations across East Africa, India, and the UAE. We help
                                    businesses optimize their operations, digitize their
                                    processes, and scale with confidence — replacing spreadsheet
                                    sprawl with one connected, measurable system.
                                </p>
                            </div>
                            <div class="col-lg-6">
                                <div class="globx-about-hero-media">
                                    <img src="/globx_website/static/src/img/about_team_group.jpg"
                                         alt="The GlobX team"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============ MISSION ============ -->
                <section class="globx_about_mission py-5">
                    <div class="container">
                        <div class="globx-mission-box">
                            <div class="row align-items-center gy-3">
                                <div class="col-auto">
                                    <img class="globx-mission-avatar"
                                         src="/globx_website/static/src/img/about_ceo_vinay_dev.jpg"
                                         alt="Vinay Dev, CEO of GlobX"/>
                                </div>
                                <div class="col">
                                    <span class="globx-mission-label">Our mission</span>
                                    <p class="globx-mission-quote">
                                        "Our mission is to empower African businesses with
                                        smart, scalable tools that fuel growth and innovation."
                                    </p>
                                    <span class="globx-mission-credit">— Vinay Dev, CEO, GlobX</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============ WHAT WE DO ============ -->
                <section class="globx_about_whatwedo py-5">
                    <div class="container">
                        <h3 class="text-white mb-4">What we do</h3>

                        <div class="row gy-4 globx-reveal-group">
                            <div class="col-md-6 globx-reveal">
                                <div class="globx-value-card">
                                    <div class="globx-value-icon">
                                        <svg viewBox="0 0 24 24"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg>
                                    </div>
                                    <b>Digital Transformation</b>
                                    <p>
                                        As an Odoo partner, we empower businesses to
                                        optimize their operations and enhance
                                        productivity through tailored ERP solutions.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-6 globx-reveal">
                                <div class="globx-value-card">
                                    <div class="globx-value-icon">
                                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg>
                                    </div>
                                    <b>Odoo Solutions &amp; Support</b>
                                    <p>
                                        We specialize in delivering tailored Odoo
                                        implementations and integrations, backed by a
                                        portfolio of successful projects across
                                        industries.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============ TIMELINE ============ -->
                <section class="globx_timeline_section py-5">
                    <div class="container">
                        <h3 class="text-white mb-5">Our journey</h3>

                        <div class="globx-journey-timeline js_globx_journey_scroll">
                            <div class="globx-journey-track">
                                <div class="globx-journey-dot"/>
                            </div>

                            <div class="globx-journey-item globx-journey-left">
                                <div class="globx-journey-marker">2018</div>
                                <div class="globx-journey-content">
                                    <b>Founded</b>
                                    <p>GlobX is founded in Rwanda, becoming an official Odoo partner.</p>
                                </div>
                            </div>

                            <div class="globx-journey-item globx-journey-right">
                                <div class="globx-journey-marker">2019</div>
                                <div class="globx-journey-content">
                                    <b>First 50 customers</b>
                                    <p>Early traction across Rwandan SMEs replacing spreadsheets with Odoo.</p>
                                </div>
                            </div>

                            <div class="globx-journey-item globx-journey-left">
                                <div class="globx-journey-marker">2021</div>
                                <div class="globx-journey-content">
                                    <b>Regional expansion</b>
                                    <p>Operations extend into Kenya, opening GlobX's first cross-border presence.</p>
                                </div>
                            </div>

                            <div class="globx-journey-item globx-journey-right">
                                <div class="globx-journey-marker">2023</div>
                                <div class="globx-journey-content">
                                    <b>India &amp; UAE</b>
                                    <p>GlobX establishes operations in India and the UAE, becoming a genuinely multi-region partner.</p>
                                </div>
                            </div>

                            <div class="globx-journey-item globx-journey-left">
                                <div class="globx-journey-marker">2025</div>
                                <div class="globx-journey-content">
                                    <b>Silver Odoo Partner</b>
                                    <p>GlobX achieves official Silver Partner status and exhibits at ACOA 2025.</p>
                                </div>
                            </div>

                            <div class="globx-journey-item globx-journey-right">
                                <div class="globx-journey-marker">2026</div>
                                <div class="globx-journey-content">
                                    <b>200+ customers</b>
                                    <p>GlobX crosses 200 successful implementations across three regions.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============ TEAM ============ -->
                <section class="globx_about_team py-5">
                    <div class="container">
                        <h3 class="text-white mb-1">Get to know our experts</h3>
                        <p class="globx-about-sub mb-4">Expert consultants driving your success</p>

                        <div class="row gy-4 globx-reveal-group">
                            <div class="col-md-6 col-lg-4 globx-reveal">
                                <div class="globx-team-card">
                                    <img class="globx-team-avatar"
                                         src="/globx_website/static/src/img/about_ceo_vinay_dev.jpg"
                                         alt="Vinay Dev, CEO"/>
                                    <b>Vinay Dev</b>
                                    <span class="globx-team-role">Principal Consultant</span>
                                    <p>
                                        Vinay spearheads our Odoo implementation and
                                        integration initiatives.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4 globx-reveal">
                                <div class="globx-team-card">
                                    <img class="globx-team-avatar"
                                         src="/globx_website/static/src/img/about_pratheesh.png"
                                         alt="Pratheesh Ezhuthupura"/>
                                    <b>Pratheesh Ezhuthupura</b>
                                    <span class="globx-team-role">Project Lead</span>
                                    <p>
                                        Pratheesh delivers impactful Odoo projects,
                                        bridging tech and business strategy.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4 globx-reveal">
                                <div class="globx-team-card">
                                    <img class="globx-team-avatar"
