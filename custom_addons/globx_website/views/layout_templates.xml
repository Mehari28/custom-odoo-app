<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Shared layout pieces used by every GlobX page.
        Header: set `globx_active` to the current page's URL before calling it,
        e.g. <t t-set="globx_active" t-value="'/about'"/>
    -->
    <template id="globx_header" name="GlobX Header">
        <header class="globx_header">
            <div class="container d-flex align-items-center justify-content-between flex-wrap py-3 gap-3">
                <a href="/home-globx" class="globx-logo">
                    <img src="/globx_website/static/src/img/globx_logo.webp" alt="GlobX" decoding="async"/>
                </a>

                <nav class="globx-nav d-none d-lg-flex align-items-center gap-4">
                    <a href="/home-globx" t-att-class="'globx-nav-active' if globx_active == '/home-globx' else None">Home</a>
                    <a href="/solutions" t-att-class="'globx-nav-active' if globx_active == '/solutions' else None">Solutions</a>
                    <a href="/casestudies" t-att-class="'globx-nav-active' if globx_active == '/casestudies' else None">Case Studies</a>
                    <a href="/news" t-att-class="'globx-nav-active' if globx_active == '/news' else None">News</a>
                    <a href="/about" t-att-class="'globx-nav-active' if globx_active == '/about' else None">About</a>
                    <a href="/contactus" t-att-class="'globx-nav-active' if globx_active == '/contactus' else None">Contact</a>
                </nav>

                <a href="/contactus" class="btn globx-btn-primary globx-header-cta d-none d-lg-inline-block">
                    Book a discovery call
                </a>

                <button class="globx-nav-toggle d-lg-none" type="button" aria-label="Toggle navigation" aria-expanded="false">
                    <span/>
                    <span/>
                    <span/>
                </button>
            </div>

            <div class="globx-mobile-nav d-lg-none">
                <a href="/home-globx" t-att-class="'globx-nav-active' if globx_active == '/home-globx' else None">Home</a>
                <a href="/solutions" t-att-class="'globx-nav-active' if globx_active == '/solutions' else None">Solutions</a>
                <a href="/casestudies" t-att-class="'globx-nav-active' if globx_active == '/casestudies' else None">Case Studies</a>
                <a href="/news" t-att-class="'globx-nav-active' if globx_active == '/news' else None">News</a>
                <a href="/about" t-att-class="'globx-nav-active' if globx_active == '/about' else None">About</a>
                <a href="/contactus" t-att-class="'globx-nav-active' if globx_active == '/contactus' else None">Contact</a>
                <a href="/contactus" class="btn globx-btn-primary mt-2">Book a discovery call</a>
            </div>
        </header>
    </template>

    <template id="globx_footer" name="GlobX Footer">
