            </a>
            </div>
                        <a href="/contactus" class="btn globx-btn-primary globx-footer-cta mt-3">Book a discovery call</a>
                    </div>
                </div>
                <div class="globx-footer-copyright">
                    &#169; <t t-out="datetime.date.today().year"/> GlobX. All rights reserved.
                </div>
            </div>
        </footer>
    </template>

    <!-- Branded "page not found" page, replacing Odoo's default one -->
    <template id="globx_404_page" name="GlobX 404 Page">
        <t t-call="website.layout">
            <t t-set="additional_title">Page not found</t>
            <div class="globx_page">
                <t t-set="globx_active" t-value="False"/>
                <t t-call="globx_website.globx_header"/>
                <section class="globx_404 py-5">
                    <div class="container text-center">
                        <span class="globx-404-code">404</span>
                        <h1 class="text-white mb-3">This page took a wrong turn</h1>
                        <p class="globx-404-lead mx-auto mb-4">
                            The page you're looking for doesn't exist or has moved.
                            These will get you back on track:
                        </p>
                        <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
                            <a href="/home-globx" class="btn globx-btn-primary">Back to home</a>
                            <a href="/solutions" class="btn globx-btn-outline">Our solutions</a>
                            <a href="/casestudies" class="btn globx-btn-outline">Case studies</a>
                            <a href="/contactus" class="btn globx-btn-outline">Contact us</a>
                        </div>
                    </div>
                </section>
                <t t-call="globx_website.globx_footer"/>
            </div>
        </t>
    </template>

    <!-- Unknown URLs on the website (most 404s) go through http_routing.404 -->
    <template id="globx_http_routing_404" inherit_id="http_routing.404" name="GlobX 404 (routing)">
        <xpath expr="//t[@t-call='web.frontend_layout']" position="attributes">
            <attribute name="t-if">not website</attribute>
        </xpath>
        <xpath expr="//t[@t-call='web.frontend_layout']" position="after">
            <t t-else="" t-call="globx_website.globx_404_page"/>
        </xpath>
    </template>

    <!-- Pages Odoo itself reports as missing go through website.page_404 -->
    <template id="globx_page_404" inherit_id="website.page_404" name="GlobX 404">
        <xpath expr="//t[@t-call='http_routing.404']" position="replace">
            <t t-call="globx_website.globx_404_page"/>
        </xpath>
    </template>
</odoo>
