            <div class="container">
                <div class="row gy-4">
                    <div class="col-lg-5">
                        <a href="/home-globx" class="globx-footer-logo" aria-label="GlobX home">
                            <img src="/globx_website/static/src/img/globx_logo.webp" alt="GlobX" loading="lazy" decoding="async"/>
                        </a>
                        <p class="mt-3 mb-3">
                            Official Odoo Silver Partner. Empowering East Africa,
                            India, and UAE with intelligent ERP solutions since 2018.
                        </p>
                        <span class="globx-footer-badge">Odoo Silver Partner</span>
                    </div>
                    <div class="col-6 col-lg-2">
                        <b class="d-block mb-2">Company</b>
                        <ul class="list-unstyled mb-0">
                            <li><a href="/home-globx">Home</a></li>
                            <li><a href="/about">About</a></li>
                            <li><a href="/news">News</a></li>
