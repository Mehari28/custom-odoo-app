<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="globx_home_page" name="GlobX Home">
        <t t-call="website.layout">
            <div id="wrap" class="globx_page">

                <t t-call="globx_website.globx_chat_widget"/>

                <!-- ============ ODOO SILVER PARTNER POPUP ============ -->
                <div id="globx_partner_popup" class="globx-partner-popup" style="display:none;">
                    <div class="globx-partner-popup-backdrop"/>
                    <div class="globx-partner-popup-card">
                        <button type="button" class="globx-partner-popup-close" aria-label="Close">
                            <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg>
                        </button>
                        <img src="/globx_website/static/src/img/globx_odoo_partner_final.webp"
                             alt="Globx is now Official: Odoo Silver Partner" decoding="async"/>
                    </div>
                </div>

                <!-- ============ HEADER ============ -->
                <t t-set="globx_active" t-value="'/home-globx'"/>
                <t t-call="globx_website.globx_header"/>

                <!-- ============ HERO ============ -->
                <section class="globx_hero py-5">
                    <div class="container">
                        <div class="row align-items-start gy-4">
                            <div class="col-lg-5">
                                <div class="globx_hero_copy">
                                    <h1 class="text-white">Scale your business, not your stress!</h1>
                                    <p class="mb-4">
                                        We replace manual bottlenecks with intelligent Odoo
                                        workflows, helping you grow without the administrative
                                        overhead.
                                    </p>
                                    <div class="d-flex flex-wrap gap-2">
                                        <a href="/contactus" class="btn globx-btn-primary">
                                            Book a discovery call
                                        </a>
                                        <a href="/solutions" class="btn globx-btn-white">
                                            Explore our solutions
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-7">
                                <div class="globx_hero_media h-100 position-relative">
                                    <div class="globx-hero-bg-clip">
                                        <div class="globx-hero-digital-bg"/>
                                        <div class="globx-hero-blob globx-hero-blob-1"/>
                                        <div class="globx-hero-blob globx-hero-blob-2"/>
                                    </div>

                                    <img class="globx-hero-character"
                                         src="/globx_website/static/src/img/hero_character.webp"
                                         alt="GlobX consultant" decoding="async" fetchpriority="high"/>

                                    <div class="globx-hero-chip-row">
                                        <div class="globx-hero-chip globx-hero-chip-top">
                                            <div class="globx-hero-chip-icon">
                                                <svg viewBox="0 0 24 24"><path d="M12 2l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4-3.9-3.8 5.4-.8z"/></svg>
                                            </div>
                                            <div>
                                                <b>Silver</b>
                                                <span>Odoo Partner</span>
                                            </div>
                                        </div>
                                        <div class="globx-hero-chip globx-hero-chip-top">
                                            <div class="globx-hero-chip-icon">
                                                <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
                                            </div>
                                            <div>
                                                <b>200+</b>
                                                <span>Customers</span>
                                            </div>
                                        </div>
                                        <div class="globx-hero-chip globx-hero-chip-top globx-region-wrap js_globx_region_cycle">
                                            <div class="globx-hero-chip-icon">
                                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9z"/></svg>
                                            </div>
                                            <div>
                                                <b>3</b>
                                                <span>Regions</span>
                                            </div>

                                            <div class="globx-region-arc">
                                                <div class="globx-region-node">East Africa</div>
                                                <div class="globx-region-node">India</div>
                                                <div class="globx-region-node">UAE</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="globx-hero-chip-orbit-wrap js_globx_module_cycle">
                                        <div class="globx-module-backdrop"/>

                                        <div class="globx-hero-chip globx-hero-chip-orbit">
                                            <div class="globx-hero-chip-icon">
                                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/></svg>
                                            </div>
                                            <div>
                                                <b>Odoo</b>
                                                <span>View modules</span>
                                            </div>
                                        </div>

                                        <div class="globx-module-polygon">
                                            <div class="globx-module-node">
                                                <div class="globx-module-node-icon">
                                                    <svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="1"/><path d="M3 7l9-4 9 4"/></svg>
                                                </div>
                                                <span>Inventory</span>
                                            </div>
                                            <div class="globx-module-node">
                                                <div class="globx-module-node-icon">
                                                    <svg viewBox="0 0 24 24"><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/><path d="M2 3h2l2.4 12.4a2 2 0 002 1.6h8.6a2 2 0 002-1.6L21 8H6"/></svg>
                                                </div>
                                                <span>Purchase</span>
                                            </div>
                                            <div class="globx-module-node">
                                                <div class="globx-module-node-icon">
                                                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 00.33 1.87 2 2 0 11-2.83 2.83 1.7 1.7 0 00-1.87-.33 1.7 1.7 0 00-1 1.55V21a2 2 0 11-4 0v-.09a1.7 1.7 0 00-1-1.55 1.7 1.7 0 00-1.87.33 2 2 0 11-2.83-2.83A1.7 1.7 0 004.6 15a1.7 1.7 0 00-1.55-1H3a2 2 0 110-4h.09A1.7 1.7 0 004.6 9a1.7 1.7 0 00-.33-1.87A2 2 0 117.1 4.3a1.7 1.7 0 001.87.33A1.7 1.7 0 0010 3v-.09a2 2 0 114 0V3a1.7 1.7 0 001 1.55 1.7 1.7 0 001.87-.33 2 2 0 112.83 2.83A1.7 1.7 0 0019.4 9a1.7 1.7 0 001.55 1H21a2 2 0 110 4h-.09a1.7 1.7 0 00-1.51 1z"/></svg>
                                                </div>
                                                <span>MRP</span>
                                            </div>
                                            <div class="globx-module-node">
                                                <div class="globx-module-node-icon">
                                                    <svg viewBox="0 0 24 24"><path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/></svg>
                                                </div>
                                                <span>Sales</span>
                                            </div>
                                            <div class="globx-module-node">
                                                <div class="globx-module-node-icon">
                                                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9 9.5c0-1.4 1.3-2.5 3-2.5s3 1.1 3 2.5-1.3 2-3 2.5-3 1.1-3 2.5 1.3 2.5 3 2.5 3-1.1 3-2.5"/></svg>
                                                </div>
                                                <span>Accounting</span>
                                            </div>
                                            <div class="globx-module-node">
                                                <div class="globx-module-node-icon">
                                                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
                                                </div>
                                                <span>Timesheet</span>
                                            </div>
                                            <div class="globx-module-node">
                                                <div class="globx-module-node-icon">
                                                    <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M2 20c0-3.3 3.1-6 7-6s7 2.7 7 6"/><circle cx="17" cy="9" r="2.3"/><path d="M15.5 13.5c2.8.3 5 2.3 5 6.5"/></svg>
                                                </div>
                                                <span>CRM</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============ CURTAIN REVEAL ============ -->
                <section class="globx_curtain_section py-5">
                    <div class="container">
                        <div class="globx-curtain-wrap js_globx_curtain">
                            <div class="globx-curtain-reveal">
                                <span class="globx-curtain-kicker">The real story</span>
                                <h2 class="text-white">
                                    The businesses winning today all have one thing in
                                    common: a unified system.
                                </h2>
                                <p>
                                    No more chasing spreadsheets, no more guessing where things
                                    stand. Just one connected system your whole team can trust.
                                </p>
                            </div>

                            <div class="globx-curtain-rod">
                                <div class="globx-curtain-rod-rings">
                                    <span/><span/><span/><span/><span/><span/><span/><span/>
                                </div>
                            </div>
                            <div class="globx-curtain-panel globx-curtain-left"/>
                            <div class="globx-curtain-panel globx-curtain-right"/>
                        </div>
                    </div>
                </section>

                <!-- ============ THE DIFFERENCE IS MANUAL CHAOS ============ -->
                <section class="globx_manual_chaos py-5">
                    <div class="container">
                        <div class="row align-items-center gy-4">

                            <div class="col-lg-6">
                                <h2 class="text-white">
                                    The Issue Lies in<br/>Manual Processes
                                </h2>
                                <p class="globx-quote fst-italic">
                                    Are you facing consistent issues like hours lost
                                    daily, manual data entry, and costly human error?
                                </p>

                                <div class="row g-3 my-3">
                                    <div class="col-6">
                                        <div class="globx-stat-box">
                                            <b>4+ Hours</b>
                                            <span>Wasted Daily</span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="globx-stat-box">
                                            <b>High Risk</b>
                                            <span>Human Error</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="globx-before-after js_globx_before_after">
                                    <img class="globx-ba-photo globx-ba-before"
                                         src="/globx_website/static/src/img/manual_chaos_photo.webp"
                                         alt="Manual, chaotic workflow" loading="lazy" decoding="async"/>

                                    <div class="globx-ba-chip" style="top:18%; left:6%;">✗ Manual entry</div>
                                    <div class="globx-ba-chip" style="top:45%; left:4%;">✗ No visibility</div>
                                    <div class="globx-ba-chip" style="bottom:14%; left:10%;">✗ Paper everywhere</div>

                                    <div class="globx-ba-after-wrap">
                                        <img class="globx-ba-photo"
                                             src="/globx_website/static/src/img/manual_chaos_after.webp"
                                             alt="Happy business owner using Odoo apps" loading="lazy" decoding="async"/>
                                        <div class="globx-ba-chip" style="top:18%; left:8%;">✓ Invoices synced</div>
                                        <div class="globx-ba-chip" style="top:45%; right:8%;">✓ Real-time visibility</div>
                                        <div class="globx-ba-chip" style="bottom:14%; left:14%;">✓ Zero manual entry</div>
                                    </div>

                                    <div class="globx-ba-handle">
                                        <span class="globx-ba-handle-arrows">&#8596;</span>
                                    </div>

                                    <span class="globx-ba-label globx-ba-label-before">Before</span>
                                    <span class="globx-ba-label globx-ba-label-after">After</span>

                                    <div class="globx-ba-hint">&#8596; Drag to compare</div>
                                </div>
                            </div>

                        </div>
                    </div>
                </section>

                <!-- ============ COST CALCULATOR ============ -->
                <section class="globx_calculator py-5">
                    <div class="container">
                        <div class="globx-calc-card js_globx_calculator">
                            <div class="row align-items-center gy-4">
                                <div class="col-lg-6">
                                    <h3>What's manual work really costing you?</h3>
                                    <p class="globx-calc-sub">
                                        Estimate the hours and cost your team loses to
                                        spreadsheets, re-entry, and manual reconciliation
                                        every year.
                                    </p>

                                    <label for="globx_calc_hours" class="globx-calc-label">
                                        Total hours per day your team spends on manual work (all employees combined)
                                        <span class="globx-calc-hours-value">2</span>
                                    </label>
                                    <input type="range" id="globx_calc_hours"
                                           class="globx-calc-slider"
                                           min="0.5" max="8" step="0.5" value="2"/>

                                    <label for="globx_calc_rate" class="globx-calc-label">
                                        Average hourly cost per employee ($)
                                        <span class="globx-calc-rate-value">15</span>
                                    </label>
                                    <input type="range" id="globx_calc_rate"
                                           class="globx-calc-slider"
                                           min="5" max="60" step="1" value="15"/>
                                </div>

                                <div class="col-lg-6">
                                    <div class="globx-calc-results">
                                        <div class="globx-calc-result">
                                            <b class="globx-calc-hours-year">0</b>
                                            <span>Hours lost per year</span>
                                        </div>
                                        <div class="globx-calc-result">
                                            <b class="globx-calc-cost-year">$0</b>
                                            <span>Value of wasted capacity per year</span>
                                        </div>
                                        <div class="globx-calc-result globx-calc-result-accent">
                                            <b class="globx-calc-weeks">0</b>
                                            <span>Work-weeks of capacity, freed up</span>
                                        </div>
                                    </div>
                                    <p class="globx-calc-explainer">
                                        This reflects time currently lost to manual work,
                                        not direct cash back. Recovering it means fewer
                                        hires needed as you grow, fewer costly errors, and
                                        more hours spent on work that actually makes you
                                        money.
                                    </p>
                                    <a href="/contactus" class="btn globx-btn-primary globx-calc-cta">
                                        See what this looks like for your business
                                    </a>
                                    <p class="globx-calc-footnote">
                                        Based on a standard 250-working-day year.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============ OUR PROCESS ============ -->
                <section class="globx_process py-5">
                    <div class="container">
                        <h2 class="text-white mb-5">Our process</h2>

                        <div class="globx-carousel js_globx_process_carousel">
                            <div class="globx-carousel-side globx-carousel-side-prev">
                                <div class="globx-carousel-preview">
                                    <span class="globx-carousel-preview-num">04</span>
                                    <span class="globx-carousel-preview-title">Drive</span>
                                </div>
                            </div>

                            <div class="globx-carousel-main">
                                <div class="globx-carousel-track">

                                    <div class="globx-carousel-slide globx-carousel-active">
                                        <div class="globx-carousel-card">
                                            <div class="globx-timeline-marker">01</div>
                                            <div class="globx-timeline-icon">
                                                <svg viewBox="0 0 24 24"><circle cx="10" cy="10" r="6"/><line x1="20" y1="20" x2="14.5" y2="14.5"/></svg>
                                            </div>
                                            <b>Discover</b>
                                            <p>We audit your current workflows and identify bottlenecks.</p>
                                            <p class="globx-carousel-detail">
                                                We start with stakeholder interviews, current-workflow
                                                audits, and system inventory to map exactly where time
                                                and accuracy are being lost.
                                            </p>
                                        </div>
                                    </div>

                                    <div class="globx-carousel-slide">
                                        <div class="globx-carousel-card">
                                            <div class="globx-timeline-marker">02</div>
                                            <div class="globx-timeline-icon">
                                                <svg viewBox="0 0 24 24"><path d="M3 21l3.5-1 11-11a2 2 0 000-2.8L15.8 4.5a2 2 0 00-2.8 0l-11 11z"/></svg>
                                            </div>
                                            <b>Design</b>
                                            <p>Architecting a custom Odoo solution for your unique DNA.</p>
                                            <p class="globx-carousel-detail">
                                                Our architects translate findings into a scoped Odoo
                                                blueprint covering modules, customizations, and data model,
                                                tailored to your operations.
                                            </p>
                                        </div>
                                    </div>

                                    <div class="globx-carousel-slide">
                                        <div class="globx-carousel-card">
                                            <div class="globx-timeline-marker">03</div>
                                            <div class="globx-timeline-icon">
                                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/></svg>
                                            </div>
                                            <b>Deploy</b>
                                            <p>Seamless migration with zero downtime and full support.</p>
                                            <p class="globx-carousel-detail">
                                                A phased rollout with parallel testing, staff training,
                                                and a zero-downtime cutover, backed by hypercare
                                                support in week one.
                                            </p>
                                        </div>
                                    </div>

                                    <div class="globx-carousel-slide">
                                        <div class="globx-carousel-card">
                                            <div class="globx-timeline-marker">04</div>
                                            <div class="globx-timeline-icon">
                                                <svg viewBox="0 0 24 24"><path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/></svg>
                                            </div>
                                            <b>Drive</b>
                                            <p>Continuous optimization and advanced growth analytics.</p>
                                            <p class="globx-carousel-detail">
                                                Ongoing monitoring dashboards, quarterly reviews, and
                                                iterative tuning keep the system improving as your
                                                business scales.
                                            </p>
                                        </div>
                                    </div>

                                </div>

                                <button type="button" class="globx-carousel-arrow globx-carousel-prev" aria-label="Previous step">
                                    <svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></svg>
                                </button>
                                <button type="button" class="globx-carousel-arrow globx-carousel-next" aria-label="Next step">
                                    <svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
                                </button>

                                <div class="globx-carousel-dots">
                                    <span class="globx-carousel-dot globx-carousel-dot-active"/>
                                    <span class="globx-carousel-dot"/>
                                    <span class="globx-carousel-dot"/>
                                    <span class="globx-carousel-dot"/>
                                </div>

                                <img class="globx-process-character"
                                     src="/globx_website/static/src/img/process_leaning_character.webp"
                                     alt="Consultant leaning on the process card" loading="lazy" decoding="async"/>
                            </div>

                            <div class="globx-carousel-side globx-carousel-side-next">
                                <div class="globx-carousel-preview">
                                    <span class="globx-carousel-preview-num">02</span>
                                    <span class="globx-carousel-preview-title">Design</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============ WHAT WE BRING TO THE TABLE ============ -->
                <section class="globx_feature_rows py-5">
                    <div class="container">

                        <div class="globx-bar-title">
                            What we bring to the table
                        </div>

                        <!-- Strategic planning -->
                        <div class="row align-items-center gy-4 mb-5 globx-reveal-group">
                            <div class="col-lg-6 globx-reveal">
                                <div class="globx-feature-copy">
                                    <h3>Strategic planning</h3>
                                    <p>
                                        Our experts don't just implement solutions, we help you
                                        rethink your business strategy for the digital age.
                                    </p>
                                </div>
                            </div>
                            <div class="col-lg-6 globx-reveal">
                                <div class="globx-feature-media-wrap">
                                    <img class="globx-feature-media"
                                         src="/globx_website/static/src/img/strategic_planning.webp"
                                         alt="Strategic planning" loading="lazy" decoding="async"/>
                                </div>
                            </div>
                        </div>

                        <!-- System Integration (image on the left this time) -->
                        <div class="row align-items-center gy-4 globx-reveal-group">
                            <div class="col-lg-6 order-lg-1 globx-reveal">
                                <div class="globx-feature-media-wrap">
                                    <img class="globx-feature-media"
                                         src="/globx_website/static/src/img/system_integration.webp"
                                         alt="System Integration" loading="lazy" decoding="async"/>
                                </div>
                            </div>
                            <div class="col-lg-6 order-lg-2 globx-reveal">
                                <div class="globx-feature-copy">
                                    <h3>System Integration</h3>
                                    <p>
                                        Connecting your existing tools into one powerful Odoo
                                        ecosystem.
                                    </p>
                                </div>
                            </div>
                        </div>

                    </div>
                </section>

                <!-- ============ PARTNERS ============ -->
                <section class="globx_partners py-5">
                    <div class="container">
                        <h2 class="text-white mb-1">Our Partners</h2>
                        <p class="globx-partners-sub mb-4">
                            Trusted by businesses across East Africa, India, and the UAE
                        </p>
                        <div class="globx-partners-grid">
                            <div class="globx-partner-card" t-foreach="[(1, 'Al-Tahs Ltd'), (2, 'Orbiz'), (3, 'Gonexgla Enterprises'), (4, 'DP Singh &amp; Associates Ltd'), (5, 'GPO Partners'), (6, 'Gorillas Hotels'), (7, 'International School of Kigali'), (8, 'Njari Acctax'), (9, 'Dr. Nambi'), (10, 'Homelink Mabati'), (11, 'Growth Partners'), (12, 'Ultimate Logistics'), (13, 'AC Mobility'), (14, 'Event &amp; Media Service Ltd'), (15, 'Office of Professional Auditors (OPA)'), (16, 'Safiya Ibn Garba'), (17, 'Zara General Trading'), (18, 'Engineering Quality'), (19, 'Ortus')]" t-as="partner">
                                <img t-attf-src="/globx_website/static/src/img/partner_logo_{{ '%02d' % partner[0] }}.png"
                                     t-att-alt="partner[1] + ' logo'" loading="lazy" decoding="async"/>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============ TESTIMONIALS ============ -->
                <section class="globx_testimonials py-5">
                    <div class="container">

                        <h2 class="text-white mb-1">Trusted by industry leaders</h2>
                        <p class="globx-testimonials-sub mb-4">
                            Real stories from our global partners
                        </p>

                        <div class="row gy-5">
                            <div class="col-md-4">
                                <div class="globx-testi-bubble">
                                    <div class="globx-testi-quote-mark">"</div>
                                    <p>
                                        Collaborating with Globx has been an immensely beneficial
                                        experience for both AC Mobility and Safiya Ibn Garba DTRF.
                                        Their team consistently operates with an exceptional level
                                        of professionalism, taking the time to deliver truly
                                        personalized support tailored perfectly to our specific
                                        organizational needs.
                                    </p>
                                    <div class="globx-testi-footer">
                                        <img class="globx-testi-avatar"
                                             src="/globx_website/static/src/img/testimonial_safiya.webp"
                                             alt="Safiya Ibn Garba" loading="lazy" decoding="async"/>
                                        <div>
                                            <b>Safiya Ibn Garba DTRF</b>
                                            <span>CEO and Lead Consultant, Kenya</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="globx-testi-bubble">
                                    <div class="globx-testi-quote-mark">"</div>
                                    <p>
                                        As a healthcare practitioner, patient accessibility is
                                        important to me. GlobX helped us achieve that with a
                                        well-designed website and an efficient appointment booking
                                        system. Their support throughout the project was
                                        professional, timely, and dependable.
                                    </p>
