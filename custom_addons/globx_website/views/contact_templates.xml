<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="globx_contact_page" name="GlobX Contact">
        <t t-call="website.layout">
            <div id="wrap" class="globx_page">

                <!-- ============ HEADER ============ -->
                <header class="globx_header">
                    <div class="container d-flex align-items-center justify-content-between flex-wrap py-3 gap-3">
                        <a href="/home-globx" class="globx-logo">Globx</a>

                        <nav class="globx-nav d-none d-lg-flex align-items-center gap-4">
                            <a href="/home-globx">Home</a>
                            <a href="/solutions">solutions</a>
                            <a href="/casestudies">casestudies</a>
                            <a href="/news">news</a>
                            <a href="/about">about</a>
                            <a href="/contactus" class="globx-nav-active">contact</a>
                        </nav>

                        <a href="/contactus" class="btn globx-btn-primary globx-header-cta d-none d-lg-inline-block">
                            Book a discovery call
                        </a>

                        <button class="globx-nav-toggle d-lg-none" type="button" aria-label="Toggle navigation" aria-expanded="false">
                            <span/>
                            <span/>
                            <span/>
                        </button>
                    </div>

                    <div class="globx-mobile-nav d-lg-none">
                        <a href="/home-globx">Home</a>
                        <a href="/solutions">solutions</a>
                        <a href="/casestudies">casestudies</a>
                        <a href="/news">news</a>
                        <a href="/about">about</a>
                        <a href="/contactus" class="globx-nav-active">contact</a>
                        <a href="/contactus" class="btn globx-btn-primary mt-2">Book a discovery call</a>
                    </div>
                </header>

                <!-- ============ CONTACT ============ -->
                <section class="globx_contact py-5">
                    <div class="container">
                        <div class="row gy-4">

                            <div class="col-lg-7">
                                <div class="globx-contact-form-card">
                                    <form id="globx_contact_form">
                                        <div class="globx-form-field">
                                            <label for="fullName">Full name</label>
                                            <input type="text" id="fullName" name="fullName" required="required"/>
                                        </div>
                                        <div class="globx-form-field">
                                            <label for="workEmail">Work email</label>
                                            <input type="email" id="workEmail" name="workEmail" required="required"/>
                                        </div>
                                        <div class="globx-form-field">
                                            <label for="company">Company</label>
                                            <input type="text" id="company" name="company" required="required"/>
                                        </div>
                                        <div class="globx-form-field">
                                            <label for="industry">Industry</label>
                                            <select id="industry" name="industry">
                                                <option value="" disabled="disabled" selected="selected">Select your industry</option>
                                                <option value="Manufacturing">Manufacturing</option>
                                                <option value="Retail &amp; Ecommerce">Retail &amp; Ecommerce</option>
                                                <option value="Distribution &amp; Logistics">Distribution &amp; Logistics</option>
                                                <option value="Finance &amp; Accounting">Finance &amp; Accounting</option>
                                                <option value="Construction">Construction</option>
                                                <option value="Healthcare">Healthcare</option>
                                                <option value="Professional Services">Professional Services</option>
                                                <option value="Technology">Technology</option>
                                                <option value="Agriculture">Agriculture</option>
                                                <option value="Hospitality">Hospitality</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </div>
                                        <div class="globx-form-field globx-industry-other-field" style="display:none;">
                                            <label for="industryOther">Please specify</label>
                                            <input type="text" id="industryOther" name="industryOther" placeholder="Tell us your industry"/>
                                        </div>
                                        <div class="globx-form-field">
                                            <label for="problem">What are you hoping to solve?</label>
                                            <textarea id="problem" name="problem" rows="4"/>
                                        </div>
                                        <button type="submit" class="btn globx-btn-primary globx-form-submit">
                                            Book a discovery call
                                        </button>
                                    </form>

                                    <div class="globx-thankyou-panel">
                                        <div class="globx-thankyou-icon">
                                            <svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
                                        </div>
                                        <h3>Thank you!</h3>
                                        <p>
                                            Your discovery call request has been received. A GlobX
                                            consultant will reach out within one business day to
                                            find a time that works for you.
                                        </p>
                                        <a href="/home-globx" class="btn globx-btn-primary">
                                            Back to Home
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-5">
                                <div class="globx-contact-info-card">
                                    <h3>Let's map the highest-value path</h3>
                                    <p>
                                        A 30-minute, scoped conversation — not a pitch — with a
                                        solutions consultant about where your operations are
                                        breaking down.
                                    </p>
                                    <ol class="globx-contact-steps">
                                        <li>We review your current process and tooling.</li>
                                        <li>We identify the highest-friction workflow to fix first.</li>
                                        <li>You leave with a scoped next step — no obligation.</li>
                                    </ol>
                                    <div class="globx-contact-direct">
                                        <span>Or reach us directly</span>
                                        <a href="mailto:info@globx.rw">info@globx.rw</a>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </section>

                <!-- ============ FOOTER ============ -->
<footer class="globx_footer py-5">
    <div class="container">
        <div class="row gy-4">
            <div class="col-lg-6">
                <b class="d-block mb-2">GlobX</b>
                <p class="mb-0">
                    Official Odoo Silver Partner. Empowering East Africa,
                    India, and UAE with intelligent ERP solutions since 2018.
                </p>
            </div>
            <div class="col-lg-3">
                <b class="d-block mb-2">Quick Links</b>
                <ul class="list-unstyled mb-0">
                    <li><a href="/solutions">Solutions</a></li>
                    <li><a href="/casestudies">Case Studies</a></li>
                </ul>
            </div>
            <div class="col-lg-3">
                <b class="d-block mb-2">Contact</b>
                <a href="mailto:info@globx.rw" class="d-block mb-2">info@globx.rw</a>
