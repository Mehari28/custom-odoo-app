                    </a>
                </div>
            </div>
        </div>
        <div class="globx-footer-copyright">
            &#169; <span id="globx-current-year">2026</span> GlobX. All rights reserved.
        </div>
    </div>
</footer>
            </div>
        </t>
    </template>

</odoo>
